# Copy to .env. Never commit .env.
MONGO_USER=streakd
MONGO_PASSWORD=change-me
MONGODB_URI=mongodb://streakd:change-me@mongo:27017/streakd?authSource=admin
# At least 32 random chars: openssl rand -hex 32
JWT_SECRET=
PORT=4000
# Comma-separated frontend origins allowed by CORS.
# In production this must be the exact frontend origin, e.g. https://huzaimm01.github.io
# (Pages is a different site from the API, so also set COOKIE_SECURE=true and COOKIE_SAMESITE=none there).
CORS_ORIGINS=http://localhost:5173,http://localhost:8080
# true when served over HTTPS. Use COOKIE_SAMESITE=none (needs secure) if the frontend is on a different site.
COOKIE_SECURE=false
COOKIE_SAMESITE=lax
ACCESS_TTL=15m
REFRESH_DAYS=30
# Password reset links. Without SMTP_URL the link is printed in the API logs instead of emailed.
APP_URL=http://localhost:8080
SMTP_URL=
MAIL_FROM=Streak’d <no-reply@example.com>
# Public URL of the API as the browser sees it (baked into the frontend at build time)
VITE_API_URL=http://localhost:4000
# Optional: friends-only signup. When set, new accounts can only be created
# with this invite code (set it in the host dashboard for a hosted instance).
# Leave unset for open registration. Never commit a real value.
# SIGNUP_CODE=your-private-invite-code
